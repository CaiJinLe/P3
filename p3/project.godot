; Engine configuration file.
config_version=5

[application]

config/name="P3"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=780
window/size/window_width_override=1280
window/size/window_height_override=780
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="P3"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.1, 1)

